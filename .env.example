# Server Configuration
PORT=50051

# Application
APP_NAME=GoMail API
APP_ENV=development

# Logging
LOG_LEVEL=info

# Storage
# Options: memory, postgres
STORAGE_DRIVER=memory
# Required when STORAGE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gomail?sslmode=disable

# Mail (required)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
